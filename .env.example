# Copy to backend/.env for local development. Never commit the real .env.
DEBUG=True
SECRET_KEY=change-me
# Leave DATABASE_URL empty to use SQLite locally, or point it at Postgres / Supabase.
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
AUTO_APPROVE_VERIFICATION=True
DEMO_PAYMENTS=True
DEMO_OTP=True
PAYSTACK_SECRET_KEY=
TERMII_API_KEY=
